{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Seeds the macOS login keychain from 1Password so tools can read secrets
# without a biometric prompt on every read. Runs only when this script's
# rendered content changes (chezmoi run_onchange hash). Bump `rotation`
# below after updating a secret in 1Password to force a re-seed on next
# `chezmoi apply`.
#
# rotation: 1

seed_secret() {
  local service="$1"
  local op_ref="$2"

  if ! command -v op >/dev/null 2>&1; then
    echo "keychain-seed: 1Password CLI (op) not found; skipping '$service'." >&2
    return 0
  fi

  echo "keychain-seed: seeding '$service' from 1Password..."
  local value
  value=$(op read -n "$op_ref")
  security add-generic-password -s "$service" -a "$USER" -U -w "$value"
}

seed_secret "github-public-ro" "op://Private/github-public-ro/credential"
{{- end }}
