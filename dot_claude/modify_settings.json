{{- /* chezmoi:modify-template */ -}}
{{- /* Merge DISABLE_UPDATES into env without replacing the rest of settings.json.
     Structural JSON so empty {}, compact env, and existing keys all stay valid.
     RTK's hook entry and unrelated settings are preserved. */ -}}
{{- $raw := trim .chezmoi.stdin -}}
{{- $data := dict -}}
{{- if $raw -}}
{{- $data = fromJson $raw -}}
{{- end -}}
{{- $env := dict -}}
{{- if hasKey $data "env" -}}
{{- with index $data "env" -}}
{{- $env = . -}}
{{- end -}}
{{- end -}}
{{- $_ := set $env "DISABLE_UPDATES" "1" -}}
{{- $_ := set $data "env" $env -}}
{{- toPrettyJson $data }}
{{- print "\n" -}}
