{{- if not (and (eq .chezmoi.os "darwin") (ne .chezmoi.arch "arm64")) -}}
# Route plain `cargo` calls through Mr. Boxington (`mbx`) so per-worktree Rust
# builds share cached compilations and copy-on-write outputs (APFS, Btrfs, XFS,
# ReFS Dev Drive) under a bounded cache budget. Uses mbx's native per-OS cache
# directory (`~/Library/Caches/mbx`, `~/.cache/mbx`, `%LOCALAPPDATA%\mbx`).
# Projects that set CARGO_TARGET_DIR, --target-dir, or build.target-dir keep
# their own target directory; build.build-dir is also preserved (without the
# check lane).
#
# Bypass for one command:
#   POSIX:      MBX_DISABLE=1 cargo build
#   PowerShell: $env:MBX_DISABLE="1"; try { cargo build } finally { Remove-Item Env:MBX_DISABLE }

[tools]
mr-boxington = "{{ .dotfiles.pins.mrBoxington }}"

[wrappers.cargo]
command = "mbx"
env = { MBX_CARGO_SHIM_MODE = "1" }
{{- end }}
