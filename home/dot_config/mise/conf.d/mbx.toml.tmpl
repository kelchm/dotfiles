{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") -}}
# Route plain `cargo` calls through Mr. Boxington (`mbx`) on Apple Silicon macOS
# so per-worktree Rust builds share APFS copy-on-write blocks under a bounded
# cache budget. Projects that set CARGO_TARGET_DIR, --target-dir, or
# build.target-dir keep their own target directory; build.build-dir is also
# preserved (without the check lane).
#
# Bypass for one command:
#   MBX_DISABLE=1 cargo build

[tools]
mr-boxington = "{{ .dotfiles.pins.mrBoxington }}"

[env]
MBX_CACHE_DIR = "{{ `{{ env.HOME }}` }}/Library/Caches/mbx"
MBX_GC_MAX_TOTAL_SIZE = "100GiB"

[wrappers.cargo]
command = "mbx"
env = { MBX_CARGO_SHIM_MODE = "1" }
{{- end }}
