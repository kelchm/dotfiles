{{- if and .bootstrap .modules.tools (ne .chezmoi.os "windows") -}}
#!/bin/bash
set -euo pipefail

# hash: {{ includeTemplate "mise/config.toml" . | sha256sum }}
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
# mbx: {{ .dotfiles.pins.mrBoxington }} {{ include "dot_config/mise/conf.d/mbx.toml.tmpl" | sha256sum }}
{{- end }}

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found on PATH. Install mise before applying tools." >&2
  exit 1
fi

mise install
mise reshim
{{- end }}
