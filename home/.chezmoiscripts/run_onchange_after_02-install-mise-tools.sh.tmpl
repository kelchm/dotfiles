{{- if and .bootstrap .modules.tools (ne .chezmoi.os "windows") -}}
#!/bin/bash
set -euo pipefail

# hash: {{ includeTemplate "mise/config.toml" . | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found on PATH. Install mise before applying tools." >&2
  exit 1
fi

mise install
{{- end }}
