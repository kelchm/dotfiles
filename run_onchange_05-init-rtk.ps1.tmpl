{{- if eq .chezmoi.os "windows" -}}
# Update this setup when adopting a new harness.
# Routine RTK upgrades do not require reinitialization; rerun manually
# when RTK documents an integration migration.
# Chezmoi reruns this script when its rendered contents change.
#
# See run_onchange_05-init-rtk.sh.tmpl. Refresh User PATH so a mise install
# from 02 in this same apply is visible, then fail if rtk is still missing.

$env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path", "User")
$shimDir = Join-Path $env:LOCALAPPDATA "mise\shims"
if (Test-Path $shimDir) {
    $env:Path = "$shimDir;$env:Path"
}

if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
    Write-Error "rtk-init: mise not found on PATH."
    exit 1
}

mise which rtk | Out-Null
if ($LASTEXITCODE -ne 0) {
    Write-Error "rtk-init: rtk is configured in mise but not installed."
    exit 1
}

mise exec -- rtk init -g --auto-patch
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
# Match chezmoi's managed Codex home even when a custom profile is active.
$previousCodexHome = $env:CODEX_HOME
try {
    $env:CODEX_HOME = Join-Path $HOME ".codex"
    mise exec -- rtk init -g --codex
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
} finally {
    $env:CODEX_HOME = $previousCodexHome
}
mise exec -- rtk init -g --opencode --auto-patch
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
{{- end }}
