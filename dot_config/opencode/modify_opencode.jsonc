{{- /* chezmoi:modify-template */ -}}
{{- /* Pin autoupdate false so mise stays the OpenCode binary owner. Do not
     manage provider/model blocks — those stay dest-only while home-lab layout
     is in flux. Insertion looks for the first `{` so a leading // comment still
     works; replacement is a line-level autoupdate assignment. */ -}}
{{- $input := .chezmoi.stdin -}}
{{- $output := "" -}}
{{- if not $input -}}
{{- $output = `{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false
}` -}}
{{- else if regexMatch `"autoupdate"\s*:` $input -}}
{{- $output = ($input | replaceAllRegex `"autoupdate"\s*:\s*(?:true|false|"notify")(\s*,?)` `"autoupdate": false${1}`) -}}
{{- else -}}
{{- $output = ($input | replaceAllRegex `(?s)^(.*?)\{` `${1}{
  "autoupdate": false,`) -}}
{{- end -}}
{{- printf "%s\n" ($output | trimSuffix "\n") -}}
