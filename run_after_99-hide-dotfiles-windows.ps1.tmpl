{{- if eq .chezmoi.os "windows" -}}
# Windows has no dotfile convention, so chezmoi-managed dotfiles show up as
# ordinary visible files in the home root. Set the hidden attribute to get the
# same filtering a POSIX shell gives dot-prefixed names.
#
# chezmoi writes files in place on Windows, so the attribute survives an apply
# that only changes content; this exists to catch newly created files.
#
# The file list is derived from `chezmoi managed` rather than hardcoded, so it
# stays correct as the repo changes and it already respects .chezmoiignore.
# Only regular files in the home root are touched; directories are left alone.
#
# LIMITATION: chezmoi only runs after_ scripts during a full-tree apply. A
# targeted apply (`chezmoi apply ~/.gitconfig`) or `chezmoi edit --apply` builds
# its target list from the arguments alone and skips scripts, so a file recreated
# that way stays visible until the next full `chezmoi apply`.

$ErrorActionPreference = 'Stop'

$chezmoi = if ($env:CHEZMOI_EXECUTABLE) { $env:CHEZMOI_EXECUTABLE } else { 'chezmoi' }
$dest    = $env:CHEZMOI_DEST_DIR
$source  = $env:CHEZMOI_SOURCE_DIR

$managed = & $chezmoi managed --source $source --destination $dest --path-style absolute --include files
if ($LASTEXITCODE -ne 0) {
    throw "chezmoi managed failed with exit code $LASTEXITCODE"
}

$prefix = "$dest/"
foreach ($target in $managed) {
    if (-not $target.StartsWith($prefix, [StringComparison]::OrdinalIgnoreCase)) { continue }
    $rel = $target.Substring($prefix.Length)
    if ($rel.Contains('/')) { continue }         # not directly in the home root
    if (-not $rel.StartsWith('.')) { continue }  # not dot-prefixed

    # Only a genuinely absent target is skipped; ACL and I/O failures must surface.
    $item = $null
    try { $item = Get-Item -LiteralPath $target -Force }
    catch [System.Management.Automation.ItemNotFoundException] { }
    if (-not $item) { continue }

    if ($item.PSIsContainer) {
        throw "expected a file but found a directory: $target"
    }
    if ($item.Attributes -band [IO.FileAttributes]::Hidden) { continue }

    $item.Attributes = $item.Attributes -bor [IO.FileAttributes]::Hidden
    Write-Host "Hid $($item.FullName)"
}
{{- end }}
