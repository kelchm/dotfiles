{{- if eq .chezmoi.os "windows" -}}
# Windows has no dotfile convention, so dot-prefixed entries show up as
# ordinary visible items in the home root. Set the hidden attribute to get the
# same filtering a POSIX shell gives dot-prefixed names.
#
# Directories: ALL dot-prefixed directories are hidden, whoever owns them.
# Writes go *into* a directory, never over it, so the hidden bit on the
# directory itself can never break a tool's write path.
#
# Files: only the chezmoi-managed ones. chezmoi is their sole writer and
# overwrites hidden files in place safely (Go >= 1.24 opens with OPEN_ALWAYS).
# Third-party dot-files are left visible on purpose: their owners may rewrite
# via create-truncate, which fails with access denied on a hidden file.
# This list must match the home-root files in `chezmoi managed`.
#
# LIMITATION: chezmoi only runs after_ scripts during a full-tree apply. A
# targeted apply (`chezmoi apply ~/.gitconfig`) or `chezmoi edit --apply`
# skips scripts, so a file recreated that way stays visible until the next
# full `chezmoi apply`.

$ErrorActionPreference = 'Stop'

$dest = $env:CHEZMOI_DEST_DIR

$managedFiles = @(
    ".default-python-packages"
    ".editorconfig"
    ".gitconfig"
)

$items = @()
foreach ($name in $managedFiles) {
    # Only a genuinely absent target is skipped; ACL and I/O failures must surface.
    try { $item = Get-Item -LiteralPath (Join-Path $dest $name) -Force }
    catch [System.Management.Automation.ItemNotFoundException] { continue }
    if ($item.PSIsContainer) {
        throw "expected a file but found a directory: $($item.FullName)"
    }
    $items += $item
}

$items += Get-ChildItem -LiteralPath $dest -Force -Directory |
    Where-Object { $_.Name.StartsWith('.') }

foreach ($item in $items) {
    if ($item.Attributes -band [IO.FileAttributes]::Hidden) { continue }
    $item.Attributes = $item.Attributes -bor [IO.FileAttributes]::Hidden
    Write-Host "Hid $($item.FullName)"
}
{{- end }}
